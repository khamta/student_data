# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (.env จะไม่ถูกคอมมิตขึ้น git)

PORT=8080

# เอา ID มาจาก URL ของ Google ชีต:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=

# วิธีที่ 1 (แนะนำ): ระบุ path ไฟล์ key ของ Service Account ที่ดาวน์โหลดจาก
# Google Cloud Console (ดูขั้นตอนใน README.md)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# วิธีที่ 2: ถ้าไม่สะดวกใช้ไฟล์ (เช่นตอน deploy บนบางแพลตฟอร์ม) ให้ใส่เนื้อหา
# JSON ทั้งไฟล์เป็นบรรทัดเดียวแทนได้ (มีค่านี้แล้วไม่ต้องใช้ตัวแปรด้านบน)
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}

# เซิร์ฟเวอร์เก็บรูปภาพ (ค่าเริ่มต้นตรงกับ Code.gs ฝั่ง Apps Script อยู่แล้ว)
IMAGE_SERVER_BASE=https://task-report.sdplao.com/api/image
